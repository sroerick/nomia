{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "nomia/exception.schema.json",
  "title": "nomia exception",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "rule", "scope", "reason", "approver", "expires"],
  "properties": {
    "id": {"type": "string", "pattern": "^exc\\.[a-z0-9-]+$"},
    "rule": {"type": "string"},
    "scope": {"type": "string", "pattern": "^[a-z]+:.+$"},
    "reason": {"type": "string", "minLength": 1},
    "approver": {"type": "string", "minLength": 1},
    "expires": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}
  }
}
