{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "$id": "nomia/policy.schema.json",
  "title": "nomia release metadata",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema", "release", "compiler", "maintainers", "budget"],
  "properties": {
    "schema": {"const": "nomia/v1"},
    "release": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "compiler": {"type": "string", "pattern": "^agentctl/[0-9]+$"},
    "description": {"type": "string"},
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "role": {"enum": ["engineering-owner", "security-owner", "policy-owner"]}
        }
      }
    },
    "budget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["core_max_bytes", "max_rules"],
      "properties": {
        "core_max_bytes": {"type": "integer", "minimum": 1},
        "max_rules": {"type": "integer", "minimum": 1}
      }
    }
  }
}
